# ---------------------------------------------------------------------------
# Copy this file to ".env" and change the values you need.
# The defaults below are PUBLIC DEMO data from the applications under test,
# so the suite runs out of the box without a .env file.
# Never commit a real .env with private credentials.
# ---------------------------------------------------------------------------

# Application under test (E2E)
BASE_URL=https://practicesoftwaretesting.com

# API under test
API_URL=https://restful-booker.herokuapp.com

# E2E demo customer (public test account from the practice site)
CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
CUSTOMER_PASSWORD=welcome01

# API admin user (public credentials documented by restful-booker)
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# Billing address used in the checkout flow
BILLING_POSTAL_CODE=01310-100
